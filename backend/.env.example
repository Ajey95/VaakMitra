APP_ENV=development
MONGODB_URL=mongodb://localhost:27017
DB_NAME=speakeasy_asd
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_COOKIE_NAME=speakeasy_access
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
CORS_ORIGIN=http://localhost:5173
CORS_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
MAX_UPLOAD_BYTES=10485760
EXPOSE_DEV_CODES=true
MONGODB_TLS_ALLOW_INVALID_CERTIFICATES=false
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
ELEVENLABS_API_KEY=
ELEVENLABS_STORY_VOICE_ID=

# Normative word-assessment runtime (VAAKMITRA_FINAL_SSOT.md).
# Production scoring remains disabled unless this points to a verified
# deployment_mode=production bundle whose files and cross-hashes all match.
VAAKMITRA_BUNDLE_CONFIG=D:\VaakMitraModels\ta-word-v1\bundle.json
VAAKMITRA_DEPLOYMENT_MODE=development
VAAKMITRA_INFERENCE_TIMEOUT_SECONDS=8
VAAKMITRA_POLICY_MODE=deterministic
VAAKMITRA_SYNC_ENABLED=false
VAAKMITRA_ALLOWED_THERAPIST_SERVICE_HOSTS=
VAAKMITRA_LOG_LEVEL=INFO
VAAKMITRA_REVIEW_SIGNING_KEY=
