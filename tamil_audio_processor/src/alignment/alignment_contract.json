{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Member 1 Alignment Output Contract",
  "type": "object",
  "properties": {
    "attempt_id": { "type": "string" },
    "capture_status": { "type": "string" },
    "expected_word": { "type": "string" },
    "expected_phonemes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "phoneme_alignment": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phoneme": { "type": "string" },
          "start_ms": { "type": "number" },
          "end_ms": { "type": "number" },
          "confidence": { "type": "number" }
        },
        "required": ["phoneme", "start_ms", "end_ms", "confidence"]
      }
    },
    "alignment_confidence": { "type": "number" }
  },
  "required": ["attempt_id", "capture_status", "expected_word", "expected_phonemes"]
}
