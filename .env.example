# ── ASD-Edge-ST 2.0 — Member 3 Backend environment template ──────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Key used to encrypt the local SQLite database via SQLCipher.
# On Android this should be derived from the Android Keystore.
# For development use any strong random string.
ASD_DB_KEY=CHANGE_ME_USE_STRONG_RANDOM_KEY

# Path to the local SQLite database file (app-private storage on Android).
# Defaults to ./asd_local.db when not set.
ASD_DB_PATH=./asd_local.db

# --------------------------------------------------------------------------
# Therapist sync endpoint
# --------------------------------------------------------------------------
# Base URL of the remote therapist server.
# Leave empty or set to the mock server URL during development.
ASD_SYNC_BASE_URL=http://localhost:9000

# Shared bearer token for therapist API authentication.
ASD_SYNC_API_TOKEN=CHANGE_ME_THERAPIST_TOKEN

# Sync retry settings
ASD_SYNC_MAX_RETRIES=5
ASD_SYNC_BACKOFF_FACTOR=2.0
ASD_SYNC_TIMEOUT_S=10

# --------------------------------------------------------------------------
# Local API server (Unity talks to this)
# --------------------------------------------------------------------------
ASD_API_HOST=127.0.0.1
ASD_API_PORT=8765
ASD_MAX_AUDIO_BYTES=320000
ASD_MEMBER1_TIMEOUT_S=15
ASD_MEMBER2_TIMEOUT_S=20
# Comma-separated browser origins. Native Unity clients do not use CORS.
ASD_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------------------------------
# Logging
# --------------------------------------------------------------------------
# Set to DEBUG for development, WARNING for production.
# CRITICAL: logs must never contain audio, embeddings, or child PII.
ASD_LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Policy / model versioning
# --------------------------------------------------------------------------
# Path to the active therapist policy JSON file.
ASD_POLICY_PATH=./config/default_policy.json
ASD_DICTIONARY_VERSION=ta-dict-1.0.0
ASD_MODEL_VERSION=unconfigured
